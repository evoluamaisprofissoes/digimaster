// =====================================================
// REGRAS DE SEGURANCA DO FIRESTORE - DigiMaster v3
// =====================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCorporateAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@evoluaprofissoes\\.com\\.br$');
    }

    function isRegisteredAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isCorporateAdmin() || isRegisteredAdmin();
    }

    // Marcadores de administradores. O proprio usuario pode apenas ler
    // seu marcador; criacao/remocao deve ser feita pelo Console/Admin SDK.
    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // Perfil agregado do aluno.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);

      // Historico de sessoes: aluno escreve as proprias sessoes;
      // administrador tem acesso somente de leitura.
      match /sessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId);
      }

      // Progresso das licoes: mesma regra do historico.
      match /lessons/{lessonId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId);
      }
    }
  }
}
